{
  "name": "keykeykey",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "audit": "pnpm audit",
    "clean": "turbo run clean && rm -rf node_modules",
    "e2e:mobile": "./scripts/run-mobile-e2e.sh ios",
    "e2e:mobile:ios": "./scripts/run-mobile-e2e.sh ios",
    "e2e:mobile:android": "./scripts/run-mobile-e2e.sh android"
  },
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@expo/plist": "^0.5.2",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.4.0",
    "sharp": "^0.34.5",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "spawn-sync"
    ],
    "overrides": {
      "tar": ">=7.5.11",
      "rollup": ">=4.40.0",
      "@tootallnate/once": ">=3.0.1",
      "flatted": ">=3.4.2",
      "undici": ">=7.24.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=3.0.0 <3.0.2": "3.0.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "node-forge@<1.4.0": "1.4.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": "5.0.5",
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "uuid@<14.0.0": "14.0.0",
      "postcss@<8.5.10": "8.5.10",
      "lodash@>=4.0.0 <=4.17.23": "4.18.1",
      "@types/react": "18.3.28",
      "@types/react-dom": "18.3.7"
    },
    "patchedDependencies": {
      "@expo/cli@0.22.28": "patches/@expo__cli@0.22.28.patch",
      "expo-secure-store@14.0.1": "patches/expo-secure-store@14.0.1.patch"
    }
  }
}
