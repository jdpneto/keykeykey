{
  "name": "keykeykey",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "audit": "pnpm audit",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ],
    "overrides": {
      "tar": "^6.2.1",
      "rollup": ">=4.40.0",
      "@tootallnate/once": ">=3.0.1"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-23950",
        "CVE-2026-24842",
        "CVE-2026-23745",
        "CVE-2026-26960",
        "CVE-2026-29786",
        "CVE-2026-31802"
      ]
    }
  }
}
