{
  "name": "keykeykey",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "audit": "pnpm audit",
    "clean": "turbo run clean && rm -rf node_modules",
    "e2e:mobile": "./scripts/run-mobile-e2e.sh ios",
    "e2e:mobile:ios": "./scripts/run-mobile-e2e.sh ios",
    "e2e:mobile:android": "./scripts/run-mobile-e2e.sh android"
  },
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@expo/plist": "^0.5.4",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "sharp": "^0.34.5",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "spawn-sync"
    ],
    "overrides": {
      "@types/react": "18.3.28",
      "@types/react-dom": "18.3.7"
    },
    "patchedDependencies": {
      "@expo/cli@0.22.28": "patches/@expo__cli@0.22.28.patch",
      "expo-secure-store@14.0.1": "patches/expo-secure-store@14.0.1.patch",
      "vitest@3.2.7": "patches/vitest@3.2.7.patch"
    }
  }
}
