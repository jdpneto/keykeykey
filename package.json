{
  "name": "keykeykey",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "audit": "pnpm audit",
    "clean": "turbo run clean && rm -rf node_modules",
    "e2e:mobile": "./scripts/run-mobile-e2e.sh ios",
    "e2e:mobile:ios": "./scripts/run-mobile-e2e.sh ios",
    "e2e:mobile:android": "./scripts/run-mobile-e2e.sh android"
  },
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@expo/plist": "^0.8.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "spawn-sync"
    ],
    "patchedDependencies": {
      "react-native-argon2@4.0.0": "patches/react-native-argon2@4.0.0.patch",
      "decode-uri-component@0.2.2": "patches/decode-uri-component@0.2.2.patch"
    },
    "overrides": {
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "uuid@<11.1.1": "11.1.1",
      "esbuild@<0.28.1": "^0.28.1"
    }
  }
}
