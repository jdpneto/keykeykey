{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-development/refs/heads/main/nicegram/nicegram-json-schema.json",
  "productName": "KeyKeyKey",
  "version": "0.0.1",
  "identifier": "com.keykeykey.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "title": "KeyKeyKey",
    "windows": [
      {
        "title": "KeyKeyKey",
        "width": 900,
        "height": 670,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
