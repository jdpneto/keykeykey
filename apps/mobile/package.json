{
  "name": "@keykeykey/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start",
    "build:eas": "eas build",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint app/",
    "clean": "rm -rf dist .expo",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios --no-install && node scripts/post-prebuild-ios.js",
    "prebuild:clean": "expo prebuild --platform ios --no-install --clean && node scripts/post-prebuild-ios.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/vector-icons": "^14.1.0",
    "@keykeykey/core": "workspace:*",
    "@keykeykey/ui": "workspace:*",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "expo": "~52.0.49",
    "expo-auth-session": "~6.0.3",
    "expo-camera": "~16.0.18",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-document-picker": "^13.1.6",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-local-authentication": "~15.0.2",
    "expo-router": "~4.0.22",
    "expo-screen-orientation": "~8.0.4",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "^13.1.5",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "~14.0.2",
    "react": "^18.3.1",
    "react-native": "0.76.9",
    "react-native-argon2": "^4.0.0",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "18.3.28",
    "eslint": "^9.39.5",
    "expo-build-properties": "~0.13.3",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base|react-native-svg|@keykeykey|jest-expo|uuid))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@keykeykey/ui$": "<rootDir>/../../packages/ui/src/index.ts",
      "^@keykeykey/core$": "<rootDir>/../../packages/core/src/index.ts",
      "^@keykeykey/core/(.*)$": "<rootDir>/../../packages/core/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ]
  }
}
