{
  "name": "@keykeykey/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start",
    "build:eas": "eas build",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint app/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .expo",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios --no-install && node scripts/post-prebuild-ios.js",
    "prebuild:clean": "expo prebuild --platform ios --no-install --clean && node scripts/post-prebuild-ios.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@keykeykey/core": "workspace:*",
    "@keykeykey/ui": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.16",
    "expo-camera": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.24",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-argon2": "^4.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.13.0",
    "expo-build-properties": "~58.0.11",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "test-renderer": "1.3.0",
    "typescript": "~7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base|react-native-svg|@keykeykey|jest-expo|uuid|@noble))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@keykeykey/ui$": "<rootDir>/../../packages/ui/src/index.ts",
      "^@keykeykey/core$": "<rootDir>/../../packages/core/src/index.ts",
      "^@keykeykey/core/(.*)$": "<rootDir>/../../packages/core/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ]
  }
}
