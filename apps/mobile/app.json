{
  "expo": {
    "name": "KeyKeyKey",
    "slug": "keykeykey",
    "version": "0.0.1",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "keykeykey",
    "splash": {
      "backgroundColor": "#1C1917"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keykeykey.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow KeyKeyKey to reach WebDAV servers on your local network. Only used when your sync server has a local IP address."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C1917"
      },
      "package": "com.keykeykey.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow KeyKeyKey to use Face ID to unlock your vault."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KeyKeyKey to use the camera to scan 2FA QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "./plugins/credential-provider",
      "./plugins/autofill-service",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "@bacons/apple-targets",
      "./plugins/ios-build-fixes"
    ]
  }
}
