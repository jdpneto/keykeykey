{
  "name": "@keykeykey/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "EXT_TARGET=chrome vite",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "EXT_TARGET=chrome vite build",
    "build:firefox": "EXT_TARGET=firefox vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src/",
    "lint:manifest": "web-ext lint --source-dir dist-firefox",
    "clean": "rm -rf dist dist-chrome dist-firefox"
  },
  "dependencies": {
    "@keykeykey/core": "workspace:*",
    "@keykeykey/ui": "workspace:*",
    "jsqr": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "web-ext": "^10.7.0"
  }
}
