{
  "browser_specific_settings": {
    "gecko": {
      "id": "keykeykey@keykeykey.app",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "activeTab", "alarms", "tabs", "identity", "clipboardWrite"],
  "background": {
    "scripts": ["src/background/index.ts"],
    "type": "module"
  }
}
